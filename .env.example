# --- Database ---
# Local dev default (scripts/db-start.sh: project-local Postgres, trust auth, port 5433):
DATABASE_URL="postgresql://postgres@localhost:5433/holistic_age"
# If using docker-compose.yml instead:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/holistic_age"

# --- Auth.js ---
AUTH_SECRET="generate-with-npx-auth-secret"
# Must match your real public URL exactly (protocol + host, no trailing slash).
# Required behind a reverse proxy (Railway, Openship, etc.) — without it, OAuth
# redirect URIs get built from request headers, which some proxies mangle
# (e.g. forwarding the container's internal host instead of the real domain),
# causing "redirect_uri_mismatch" errors from Google/Facebook/Apple.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth providers — leave unset to hide the corresponding button on /login and /signup.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Email ---
# "console" (default) logs emails to the server console instead of sending them — no key needed for local dev.
# Set to "resend" once RESEND_API_KEY is configured to send real email.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Holistic Age <onboarding@holisticage.app>"

# --- Cron ---
# Bearer token required to call /api/cron/reminders.
CRON_SECRET="dev-cron-secret-change-me"
